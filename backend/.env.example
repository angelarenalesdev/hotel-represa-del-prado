# Copia este archivo como .env y completa tus valores

# Puerto del servidor
PORT=5000

# Cadena de conexión de MongoDB Atlas (o local: mongodb://127.0.0.1:27017/hotel-prado)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster.xxxxx.mongodb.net/hotel-prado

# Clave secreta para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esta_clave_por_una_segura

NODE_ENV=development

# Usuario administrador que crea "npm run seed:admin"
ADMIN_EMAIL=admin@tuhotel.com
ADMIN_PASSWORD=una_contraseña_segura
